{
  "name": "eve-crashtest",
  "version": "0.1.0",
  "description": "Crash-test ratings for eve agents",
  "type": "module",
  "bin": {
    "crashtest": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.2"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.ts\"",
    "test:e2e:smoke": "node --test --test-concurrency=1 --test-name-pattern=smoke \"test/e2e/**/*.test.ts\""
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.45.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "eve": "1.5.0",
    "typescript": "7.0.2"
  }
}
